                    "tenantId": {
                      "type": "string"
                    },
                    "brandId": {
                      "type": "string"
                    },
                    "write": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "tenantId",
                    "brandId",
                    "write"
                  ]
