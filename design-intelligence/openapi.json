  "components": {
    "securitySchemes": {
      "DesignToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Style": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "label": {
            "type": "string"
          },
          "colors": {
            "type": [
              "object",
              "null"
            ]
          },
          "tokens": {
            "type": [
              "object",
              "null"
            ]
          },
          "tokenCompatibility": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "colors",
          "tokens",
          "tokenCompatibility"
        ]
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ]
