    "/design-recipes/{id}/revisions": {
      "get": {
        "operationId": "listRecipeRevisions",
        "description": "Only when the Worker has DESIGN_REVISIONS=enabled (and migration 0003 applied); otherwise 404. Newest first, at most 50.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,100}$"
